{
  "name": "@ai-ecoverse/slicc-audio",
  "version": "0.0.0",
  "description": "say, hear, afplay and chime for SLICC, and scsay, schear, scplay and scchime for SLICC and any host",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-audio.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "scsay": "host/scsay.mjs",
    "schear": "host/schear.mjs",
    "scplay": "host/scplay.mjs",
    "scchime": "host/scchime.mjs"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-audio",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "slicc": {
    "unitSources": [
      "host"
    ]
  },
  "files": [
    "host"
  ],
  "scripts": {
    "prepare": "slicc-install-hooks",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "test": "node --test --test-timeout=120000 test/integration/*.test.mjs",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "build": "npm pack --dry-run",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "2.11.3",
    "@biomejs/biome": "2.5.15",
    "@semantic-release/exec": "7.1.0",
    "lefthook": "2.2.2",
    "monocart-coverage-reports": "2.13.2",
    "semantic-release": "25.0.9"
  },
  "optionalDependencies": {
    "@ai-ecoverse/slicc-ortllama": "^1.26.1"
  }
}
