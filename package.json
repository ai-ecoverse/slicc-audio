{
  "name": "@ai-ecoverse/slicc-audio",
  "version": "0.0.0",
  "description": "say, hear, afplay and chime for SLICC, and scsay, schear, scplay and scchime for SLICC and any host",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-audio.git"
  },
  "engines": {
    "node": ">=24",
    "slicc-kernel": ">=1.153.0"
  },
  "exports": {
    "./page": "./page/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "scsay": "host/scsay.mjs",
    "schear": "host/schear.mjs",
    "scplay": "host/scplay.mjs",
    "scchime": "host/scchime.mjs"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-audio",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "slicc": {
    "commands": {
      "say": {
        "script": "bin/say"
      },
      "scsay": {
        "script": "bin/scsay"
      },
      "hear": {
        "script": "bin/hear"
      },
      "schear": {
        "script": "bin/schear"
      },
      "afplay": {
        "script": "bin/afplay"
      },
      "scplay": {
        "script": "bin/scplay"
      },
      "chime": {
        "script": "bin/chime"
      },
      "scchime": {
        "script": "bin/scchime"
      }
    },
    "unitSources": [
      "host",
      "page"
    ]
  },
  "files": [
    "bin",
    "host",
    "page",
    "sh"
  ],
  "scripts": {
    "prepare": "slicc-install-hooks",
    "lint": "slicc-lint && shellcheck -s sh install.sh && dash -n install.sh && sh scripts/lint-sh.sh",
    "format": "biome check --write .",
    "test": "node --test --test-timeout=120000 test/integration/*.test.mjs",
    "test:windows": "node --test --test-concurrency=1 --test-timeout=600000 test/integration/say.test.mjs test/integration/hear.test.mjs test/integration/play.test.mjs test/integration/runtime.test.mjs test/integration/windows.test.mjs",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test --test-concurrency=1 'test/unit/**/*.test.mjs' && node scripts/cover-sh.mjs",
    "build": "npm pack --dry-run",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-kernel": "1.167.2",
    "@ai-ecoverse/slicc-shared-web": "2.13.0",
    "@ai-ecoverse/wasm-bash": "5.3.0-23",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-15",
    "@biomejs/biome": "2.5.15",
    "@semantic-release/exec": "7.1.0",
    "lefthook": "2.2.2",
    "monocart-coverage-reports": "2.13.2",
    "semantic-release": "25.0.9",
    "slicc-kernel-without-embedder": "npm:@ai-ecoverse/slicc-kernel@1.152.2"
  },
  "optionalDependencies": {
    "@ai-ecoverse/slicc-ortllama": "^1.28.0"
  }
}
